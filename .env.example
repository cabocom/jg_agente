# Entorno y servicio
ENV=development
DEBUG=false
AGENT_ID=jg_agente_local
AGENT_PORT=8001

# PostgreSQL
POSTGRES_HOST=jg_agente_postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jg_agente

# Puerto expuesto en el host para PostgreSQL (evita conflicto con 5432)
POSTGRES_HOST_PORT=5433

# Secreto permanente para autenticación HMAC-SHA256 con jg_dashboard (GLOBAL-01)
PERMANENT_AGENT_SECRET=cambiar_por_secreto_hmac_permanente
